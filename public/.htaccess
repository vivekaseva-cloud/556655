# ====================================================================
# Hostinger Apache / LiteSpeed Configuration for Neti Bharatam SPA & PWA
# ====================================================================

# 1. Enable Rewrite Engine
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Optional HTTPS redirect (uncomment if not handled automatically by Hostinger SSL)
  # RewriteCond %{HTTPS} off
  # RewriteCond %{HTTP_HOST} !^localhost [NC]
  # RewriteCond %{HTTP_HOST} !^127\.0\.0\.1 [NC]
  # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Allow existing files or directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirect all other requests to index.html for React Single Page Application routing
  RewriteRule ^ index.html [L]
</IfModule>

# 2. Correct MIME Types
<IfModule mod_mime.c>
  AddType application/manifest+json .webmanifest
  AddType application/json .json
  AddType image/svg+xml .svg .svgz
  AddType font/woff2 .woff2
  AddType font/woff .woff
  AddType font/ttf .ttf
  AddType font/eot .eot
  AddType font/otf .otf
  AddType text/javascript .js .mjs
  AddType text/css .css
</IfModule>

# 3. Compression (Gzip / Deflate for fast mobile loading in India)
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript
  AddOutputFilterByType DEFLATE application/json application/xml application/xhtml+xml
  AddOutputFilterByType DEFLATE image/svg+xml application/manifest+json
  AddOutputFilterByType DEFLATE font/ttf font/otf font/woff font/woff2
</IfModule>

# 4. Cache-Control Headers for PWA & Static Assets
<IfModule mod_headers.c>
  # Service Worker and Manifest must NOT be cached so app updates propagate immediately
  <FilesMatch "(sw\.js|registerSW\.js|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Cache hashed production bundles (Vite outputs /assets/index-*.js and /assets/index-*.css) for 1 year
  <FilesMatch "\.(js|mjs|css|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$">
    Header set Cache-Control "max-age=31536000, public, immutable"
  </FilesMatch>

  # HTML entry point must check for new versions
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # Security Headers
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# 5. Disable Directory Browsing
Options -Indexes
